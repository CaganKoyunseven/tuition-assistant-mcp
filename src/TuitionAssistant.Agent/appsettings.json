{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Llm": {
    "Provider": "OpenAI",
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-4o-mini",
    "AllowedModels": "",
    "MaxToolIterations": 5,
    "InputPricePerMillion": 0.15,
    "OutputPricePerMillion": 0.60
  },
  "Gateway": { "BaseUrl": "http://localhost:8000" },
  "Mcp": { "Url": "http://localhost:8081/mcp" },
  "Jwt": { "Issuer": "tuition-auth", "Audience": "tuition-api" },
  "Agent": {
    "PendingPaymentTtlSeconds": 300,
    "HistoryMaxMessages": 20,
    "SessionIdleMinutes": 30,
    "TraceDirectory": "traces"
  }
}
