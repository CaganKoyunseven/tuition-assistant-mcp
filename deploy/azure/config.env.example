# Copy to deploy/azure/config.env (git-ignored) and adjust. deploy.sh fills the blank values:
#   - AZ_SUFFIX, PG_ADMIN_PASSWORD, MCP_API_KEY are generated on the first run;
#   - OPENAI_API_KEY is asked for (silent prompt) if it is blank.
# Real values are written back to config.env only. Never commit that file.

# Use a region that your subscription policy allows (check: az policy assignment list).
AZ_LOCATION='germanywestcentral'
AZ_RESOURCE_GROUP='rg-se4458-tuition'

# Optional: PostgreSQL region and server name when the database must live elsewhere than the apps
# (a SKU can be unavailable in the app region; Container Apps are not offered in every region).
# Leave blank to use AZ_LOCATION and the generated name.
AZ_PG_LOCATION=''
PG_SERVER_NAME=''

# Short random suffix that makes the registry and database names globally unique (generated).
AZ_SUFFIX=''

PG_ADMIN_USER='tuition'
PG_ADMIN_PASSWORD=''

# Shared secret between agent and MCP server (generated, at least 16 characters).
MCP_API_KEY=''

# LLM used by the agent. LLM_MODEL must be a model your key can use.
# gpt-4o-mini is removed from the OpenAI API on 2027-01-14; set another model name after that date.
OPENAI_API_KEY=''
LLM_MODEL='gpt-4o-mini'
LLM_ALLOWED_MODELS=''

# Demo credentials created by the seeder (same defaults as the local stack).
SEED_ADMIN_PASSWORD='Admin#2026'
SEED_STUDENT_PASSWORD='Student#2026'
SEED_BANK_CLIENT_SECRET='BankSecret#2026'
