# Copy to .env and fill in. .env is git-ignored; never commit real values.

# PostgreSQL (container-internal; not published to the host)
POSTGRES_USER=tuition
POSTGRES_PASSWORD=change-me

# RS256 key pair: run ./scripts/gen-keys.sh and paste the two printed lines here
JWT_PRIVATE_KEY_PEM=paste-from-scripts/gen-keys.sh
JWT_PUBLIC_KEY_PEM=paste-from-scripts/gen-keys.sh

# Shared secret between the agent and the MCP server (at least 16 characters),
# e.g. openssl rand -hex 24
MCP_API_KEY=change-me-at-least-16-characters

# LLM (used by the agent). Bring your own key and model.
# OPENAI_API_KEY: any key for an OpenAI-compatible Chat Completions API.
# LLM_MODEL: default model. gpt-4o-mini is cheap but OpenAI removes it from the API on 2027-01-14;
#            afterwards set any current model name (e.g. gpt-5-mini) here. No code change is needed.
# LLM_ALLOWED_MODELS: optional extra models (comma separated) a chat request may pick instead of the default.
# LLM_BASE_URL: change only to use another OpenAI-compatible provider.
# LLM_PROVIDER: OpenAI (real, graded mode) or Fake (offline demo without a key).
OPENAI_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini
LLM_ALLOWED_MODELS=
LLM_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=OpenAI

# Demo credentials created by the seeder
SEED_ADMIN_PASSWORD=Admin#2026
SEED_STUDENT_PASSWORD=Student#2026
SEED_BANK_CLIENT_SECRET=BankSecret#2026
